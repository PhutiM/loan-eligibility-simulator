@page "/"
@using System.Globalization
@using System.Text.Json
@using LoanEligibility.Api
@inject ILogger<Home> Logger

<PageTitle>Loan Eligibility Simulator</PageTitle>

<div class="simulator-grid">
    <section class="card intro-card">
        <h1>Loan Eligibility Simulator</h1>
        <p>Enter your details to see your estimated eligibility, recommended loan amount and monthly repayments.</p>
    </section>

    <EditForm EditContext="_editContext"
              OnSubmit="SubmitAsync"
              FormName="eligibility-application"
              aria-label="Loan eligibility application"
              novalidate>
        <div class="form-stack">
            <section class="card form-section" aria-labelledby="personal-heading">
                <div class="section-heading">
                    <span class="section-icon" aria-hidden="true">♙</span>
                    <h2 id="personal-heading">Personal Information</h2>
                </div>
                <div class="field-grid three-columns">
                    <div class="field">
                        <label for="age">Age</label>
                        <InputNumber id="age" class="form-control" @bind-Value="_form.PersonalInfo.Age" min="18" max="65"
                                     aria-invalid="@AriaInvalid(_form.PersonalInfo, nameof(_form.PersonalInfo.Age))"
                                     aria-describedby="age-error" />
                        <div id="age-error"><ValidationMessage For="() => _form.PersonalInfo.Age" /></div>
                    </div>
                    <div class="field">
                        <label for="employment-status">Employment Status</label>
                        <InputSelect id="employment-status" class="form-control" @bind-Value="_form.PersonalInfo.EmploymentStatus"
                                     aria-invalid="@AriaInvalid(_form.PersonalInfo, nameof(_form.PersonalInfo.EmploymentStatus))"
                                     aria-describedby="employment-status-error">
                            <option value="">Select an option</option>
                            <option value="employed">Employed</option>
                            <option value="self_employed">Self-employed</option>
                            <option value="unemployed">Unemployed</option>
                            <option value="retired">Retired</option>
                        </InputSelect>
                        <div id="employment-status-error"><ValidationMessage For="() => _form.PersonalInfo.EmploymentStatus" /></div>
                    </div>
                    <div class="field">
                        <label for="employment-duration">Employment Duration (months)</label>
                        <InputNumber id="employment-duration" class="form-control" @bind-Value="_form.PersonalInfo.EmploymentDuration" min="3"
                                     aria-invalid="@AriaInvalid(_form.PersonalInfo, nameof(_form.PersonalInfo.EmploymentDuration))"
                                     aria-describedby="employment-duration-error" />
                        <div id="employment-duration-error"><ValidationMessage For="() => _form.PersonalInfo.EmploymentDuration" /></div>
                    </div>
                </div>
            </section>

            <section class="card form-section" aria-labelledby="financial-heading">
                <div class="section-heading">
                    <span class="section-icon" aria-hidden="true">▤</span>
                    <h2 id="financial-heading">Financial Information</h2>
                </div>
                <div class="field-grid two-columns">
                    <div class="field">
                        <label for="monthly-income">Monthly Income (ZAR)</label>
                        <InputNumber id="monthly-income" class="form-control" @bind-Value="_form.FinancialInfo.MonthlyIncome" min="5000"
                                     aria-invalid="@AriaInvalid(_form.FinancialInfo, nameof(_form.FinancialInfo.MonthlyIncome))"
                                     aria-describedby="monthly-income-error" />
                        <div id="monthly-income-error"><ValidationMessage For="() => _form.FinancialInfo.MonthlyIncome" /></div>
                    </div>
                    <div class="field">
                        <label for="monthly-expenses">Monthly Expenses (ZAR)</label>
                        <InputNumber id="monthly-expenses" class="form-control" @bind-Value="_form.FinancialInfo.MonthlyExpenses" min="0"
                                     aria-invalid="@AriaInvalid(_form.FinancialInfo, nameof(_form.FinancialInfo.MonthlyExpenses))"
                                     aria-describedby="monthly-expenses-error" />
                        <div id="monthly-expenses-error"><ValidationMessage For="() => _form.FinancialInfo.MonthlyExpenses" /></div>
                    </div>
                    <div class="field">
                        <label for="existing-debt">Existing Debt (ZAR)</label>
                        <InputNumber id="existing-debt" class="form-control" @bind-Value="_form.FinancialInfo.ExistingDebt" min="0"
                                     aria-invalid="@AriaInvalid(_form.FinancialInfo, nameof(_form.FinancialInfo.ExistingDebt))"
                                     aria-describedby="existing-debt-error" />
                        <div id="existing-debt-error"><ValidationMessage For="() => _form.FinancialInfo.ExistingDebt" /></div>
                    </div>
                    <div class="field">
                        <label for="credit-score">Credit Score (optional)</label>
                        <InputNumber id="credit-score" class="form-control" @bind-Value="_form.FinancialInfo.CreditScore" min="300" max="850"
                                     aria-invalid="@AriaInvalid(_form.FinancialInfo, nameof(_form.FinancialInfo.CreditScore))"
                                     aria-describedby="credit-score-error" />
                        <div id="credit-score-error"><ValidationMessage For="() => _form.FinancialInfo.CreditScore" /></div>
                    </div>
                </div>
            </section>

            <section class="card form-section" aria-labelledby="loan-heading">
                <div class="section-heading">
                    <span class="section-icon" aria-hidden="true">▧</span>
                    <h2 id="loan-heading">Loan Details</h2>
                </div>
                <div class="field-grid three-columns">
                    <fieldset class="field product-field">
                        <legend>Loan Product</legend>
                        <InputRadioGroup TValue="string"
                                         Value="_form.LoanDetails.LoanType"
                                         ValueChanged="ChangeProduct"
                                         ValueExpression="() => _form.LoanDetails.LoanType"
                                         aria-required="true"
                                         aria-invalid="@(_messages[LoanTypeField].Any() ? "true" : "false")"
                                         aria-describedby="@(_showValidation && _messages[LoanTypeField].Any() ? "product-error" : null)">
                            <div class="product-options">
                                @foreach (var product in Products)
                                {
                                    <label class="product-option @(_form.LoanDetails.LoanType == product.Id ? "selected" : "")">
                                        <InputRadio TValue="string" Value="@product.Id" />
                                        <span>@product.Name</span>
                                    </label>
                                }
                            </div>
                        </InputRadioGroup>
                        @if (_showValidation)
                        {
                            <div class="validation-message" id="product-error">
                                @foreach (var message in _messages[LoanTypeField])
                                {
                                    <span>@message</span>
                                }
                            </div>
                        }
                    </fieldset>
                    <div class="field full-row">
                        <label for="loan-purpose">Loan Purpose</label>
                        <InputSelect id="loan-purpose" class="form-control"
                                     @bind-Value="_form.LoanDetails.LoanPurpose"
                                     disabled="@(SelectedProduct is null)"
                                     aria-invalid="@AriaInvalid(_form.LoanDetails, nameof(_form.LoanDetails.LoanPurpose))"
                                     aria-describedby="loan-purpose-error">
                            <option value="">@(SelectedProduct is null ? "Select a loan product first" : "Select a loan purpose")</option>
                            @if (SelectedProduct is not null)
                            {
                                @foreach (var purpose in SelectedProduct.Purposes)
                                {
                                    <option value="@purpose">@DisplayWords(purpose)</option>
                                }
                            }
                        </InputSelect>
                        <div id="loan-purpose-error"><ValidationMessage For="() => _form.LoanDetails.LoanPurpose" /></div>
                    </div>
                    <div class="field amount-field">
                        <label for="requested-amount">Requested Loan Amount (ZAR)</label>
                        <InputNumber id="requested-amount" class="form-control"
                                     @bind-Value="_form.LoanDetails.RequestedAmount"
                                     min="@SelectedProduct?.MinAmount"
                                     max="@SelectedProduct?.MaxAmount"
                                     disabled="@(SelectedProduct is null)"
                                     aria-invalid="@AriaInvalid(_form.LoanDetails, nameof(_form.LoanDetails.RequestedAmount))"
                                     aria-describedby="requested-amount-error" />
                        <div id="requested-amount-error"><ValidationMessage For="() => _form.LoanDetails.RequestedAmount" /></div>
                    </div>
                    <div class="field">
                        <label for="loan-term">Loan Term</label>
                        <InputSelect id="loan-term" class="form-control"
                                     @bind-Value="_form.LoanDetails.LoanTerm"
                                     disabled="@(SelectedProduct is null)"
                                     aria-invalid="@AriaInvalid(_form.LoanDetails, nameof(_form.LoanDetails.LoanTerm))"
                                     aria-describedby="loan-term-error">
                            <option value="">Select an option</option>
                            @foreach (var term in TermOptions)
                            {
                                <option value="@term">@term months</option>
                            }
                        </InputSelect>
                        <div id="loan-term-error"><ValidationMessage For="() => _form.LoanDetails.LoanTerm" /></div>
                    </div>
                </div>
            </section>

            <button class="primary-button" type="submit" disabled="@_isSubmitting">
                @(_isSubmitting ? "Checking Eligibility…" : "▣　Check Eligibility")
            </button>
        </div>
    </EditForm>

    <aside class="result-column">
        <section class="information-card">
            <span class="information-icon" aria-hidden="true">i</span>
            <div>
                <h2>Important Information</h2>
                <p>This is a simplified estimate, not a loan offer or credit decision. Actual eligibility depends on credit history, verified income, lender affordability rules, fees and other criteria.</p>
            </div>
        </section>

        @if (!string.IsNullOrEmpty(_apiError))
        {
            <div class="alert error-alert" role="alert">@_apiError</div>
        }

        @if (_result is not null)
        {
            <div class="result-stack">
                <section class="eligibility-result @(_result.EligibilityResult.IsEligible ? "eligible" : "not-eligible")"
                         role="status"
                         aria-label="@($"{EligibilityTitle} Approval likelihood: {Likelihood}%")">
                    <div class="result-copy">
                        <span class="result-mark" aria-hidden="true">@(_result.EligibilityResult.IsEligible ? "✓" : "×")</span>
                        <div>
                            <h2>@EligibilityTitle</h2>
                            <p>@LikelihoodDescription</p>
                        </div>
                    </div>
                    <div class="likelihood">
                        <div class="likelihood-ring" style="@($"--likelihood:{Likelihood}%;")">
                            <span>@Likelihood%</span>
                        </div>
                        <span>Approval Likelihood</span>
                    </div>
                </section>

                @if (_repayment is not null)
                {
                    <section class="card loan-result">
                        <div class="section-heading">
                            <span class="section-icon blue-icon" aria-hidden="true">▤</span>
                            <h2>Loan Details</h2>
                        </div>
                        <div class="loan-overview">
                            <div class="requested-amount">
                                <span>Requested Amount</span>
                                <strong>R @FormatAmount(_result.RecommendedLoan.RecommendedAmount)</strong>
                                <span>(within your eligible range)</span>
                            </div>
                            <div class="loan-facts">
                                <div><span>Maximum Amount</span><strong>R @FormatAmount(_result.RecommendedLoan.MaxAmount)</strong></div>
                                <div><span>Interest Rate</span><strong>@_repayment.InterestRate% p.a.</strong></div>
                            </div>
                        </div>
                        <div class="metric-grid">
                            <div class="metric"><span>Monthly Payment</span><strong>R @FormatCurrency(_repayment.MonthlyPayment)</strong></div>
                            <div class="metric"><span>Total Repayment</span><strong>R @FormatCurrency(_repayment.TotalRepayment)</strong></div>
                            <div class="metric"><span>Loan Term</span><strong>@_calculatedLoanTerm months</strong></div>
                        </div>
                    </section>
                }
                <button class="secondary-button" type="button" @onclick="ResetCalculator">Reset Calculator</button>
            </div>
        }
        else
        {
            <section class="card welcome-card">
                <h2>Ready to get started?</h2>
                <img src="images/loan-start-illustration.svg" alt="" />
                <p>Complete the form to see your personalised financial summary, including your estimated loan amount and monthly repayments.</p>
            </section>
        }
    </aside>
</div>

@code {
    private static readonly JsonSerializerOptions ApiJsonOptions = new(JsonSerializerDefaults.Web);
    private readonly LoanProduct[] Products = LoanService.Products;
    private EligibilityApplicationForm _form = new();
    private EditContext _editContext = default!;
    private ValidationMessageStore _messages = default!;
    private EligibilityResponse? _result;
    private RateCalculationResponse? _repayment;
    private int? _calculatedLoanTerm;
    private string _apiError = "";
    private bool _isSubmitting;
    private bool _showValidation;

    private FieldIdentifier LoanTypeField => new(_form.LoanDetails, nameof(_form.LoanDetails.LoanType));
    private LoanProduct? SelectedProduct => Products.FirstOrDefault(product => product.Id == _form.LoanDetails.LoanType);
    private IEnumerable<int> TermOptions => SelectedProduct is null
        ? []
        : Enumerable.Range(0, (SelectedProduct.MaxTerm - SelectedProduct.MinTerm) / 6 + 1)
            .Select(index => SelectedProduct.MinTerm + index * 6)
            .Append(SelectedProduct.MaxTerm)
            .Distinct()
            .Order();
    private int Likelihood => Math.Clamp(_result?.EligibilityResult.ApprovalLikelihood ?? 0, 0, 100);
    private bool IsLikely => _result?.EligibilityResult.IsEligible == true && Likelihood >= 70;
    private string EligibilityTitle => IsLikely
        ? "You are likely eligible!"
        : _result?.EligibilityResult.IsEligible == true
            ? "You may be eligible"
            : "You are unlikely to be eligible";
    private string LikelihoodDescription => Likelihood >= 70
        ? "Based on the information provided, you have a high chance of approval."
        : Likelihood >= 40
            ? "Based on the information provided, you have a moderate chance of approval."
            : "Based on the information provided, your chance of approval is low.";

    protected override void OnInitialized()
    {
        InitializeEditContext();
    }

    private void InitializeEditContext()
    {
        _editContext = new EditContext(_form);
        _messages = new ValidationMessageStore(_editContext);
    }

    private bool HasErrors(object model, string propertyName) =>
        _messages[new FieldIdentifier(model, propertyName)].Any();

    private string AriaInvalid(object model, string propertyName) =>
        HasErrors(model, propertyName) ? "true" : "false";

    private void ChangeProduct(string value)
    {
        if (_form.LoanDetails.LoanType == value)
        {
            return;
        }

        _form.LoanDetails.LoanType = value;
        _form.LoanDetails.LoanPurpose = "";
        _form.LoanDetails.RequestedAmount = null;
        _form.LoanDetails.LoanTerm = null;
        _messages.Clear(new FieldIdentifier(_form.LoanDetails, nameof(_form.LoanDetails.LoanPurpose)));
        _messages.Clear(new FieldIdentifier(_form.LoanDetails, nameof(_form.LoanDetails.RequestedAmount)));
        _messages.Clear(new FieldIdentifier(_form.LoanDetails, nameof(_form.LoanDetails.LoanTerm)));
        _messages.Clear(LoanTypeField);
        _editContext.NotifyValidationStateChanged();
    }

    private async Task SubmitAsync(EditContext _)
    {
        _messages.Clear();
        _showValidation = true;
        _apiError = "";
        _result = null;
        _repayment = null;
        _calculatedLoanTerm = null;

        using var document = JsonDocument.Parse(JsonSerializer.Serialize(_form, ApiJsonOptions));
        var assessment = LoanService.ValidateEligibilityRequest(document.RootElement);
        if (assessment.Errors.Count > 0)
        {
            foreach (var error in assessment.Errors)
            {
                var field = GetFieldIdentifier(error.Field);
                if (field is not null)
                {
                    _messages.Add(field.Value, error.Message);
                }
                else
                {
                    Logger.LogWarning("No form field is mapped for validation error {Field}", error.Field);
                    _apiError = "Some application details could not be validated. Please review the form and try again.";
                }
            }
            _editContext.NotifyValidationStateChanged();
            return;
        }

        _isSubmitting = true;
        try
        {
            await Task.Yield();
            var result = LoanService.CalculateEligibility(assessment);
            _result = result;
            if (result.EligibilityResult.IsEligible && assessment.Product is not null)
            {
                var rate = LoanService.GetRate(assessment.CreditScore, assessment.Product);
                var repayment = LoanService.CalculateRepayment(
                    result.RecommendedLoan.RecommendedAmount,
                    assessment.LoanTerm,
                    rate);
                _repayment = new RateCalculationResponse(
                    rate,
                    repayment.MonthlyPayment,
                    repayment.TotalInterest,
                    repayment.TotalRepayment,
                    repayment.PaymentSchedule);
                _calculatedLoanTerm = (int)assessment.LoanTerm;
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to calculate loan eligibility");
            _apiError = "Unable to check eligibility. Please try again.";
            _result = null;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private FieldIdentifier? GetFieldIdentifier(string field) => field switch
    {
        "personalInfo.age" => new(_form.PersonalInfo, nameof(_form.PersonalInfo.Age)),
        "personalInfo.employmentStatus" => new(_form.PersonalInfo, nameof(_form.PersonalInfo.EmploymentStatus)),
        "personalInfo.employmentDuration" => new(_form.PersonalInfo, nameof(_form.PersonalInfo.EmploymentDuration)),
        "financialInfo.monthlyIncome" => new(_form.FinancialInfo, nameof(_form.FinancialInfo.MonthlyIncome)),
        "financialInfo.monthlyExpenses" => new(_form.FinancialInfo, nameof(_form.FinancialInfo.MonthlyExpenses)),
        "financialInfo.existingDebt" => new(_form.FinancialInfo, nameof(_form.FinancialInfo.ExistingDebt)),
        "financialInfo.creditScore" => new(_form.FinancialInfo, nameof(_form.FinancialInfo.CreditScore)),
        "loanDetails.loanType" => LoanTypeField,
        "loanDetails.loanPurpose" => new(_form.LoanDetails, nameof(_form.LoanDetails.LoanPurpose)),
        "loanDetails.requestedAmount" => new(_form.LoanDetails, nameof(_form.LoanDetails.RequestedAmount)),
        "loanDetails.loanTerm" => new(_form.LoanDetails, nameof(_form.LoanDetails.LoanTerm)),
        _ => null
    };

    private void ResetCalculator()
    {
        _form = new EligibilityApplicationForm();
        InitializeEditContext();
        _result = null;
        _repayment = null;
        _calculatedLoanTerm = null;
        _apiError = "";
        _showValidation = false;
    }

    private static string DisplayWords(string value) =>
        string.Join(' ', value.Split('_').Select(word => char.ToUpperInvariant(word[0]) + word[1..]));

    private static string FormatAmount(double amount) =>
        amount.ToString("N0", CultureInfo.GetCultureInfo("en-US"));

    private static string FormatCurrency(double amount) =>
        amount.ToString("N2", CultureInfo.GetCultureInfo("en-US"));

}

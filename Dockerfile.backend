FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

WORKDIR /src

COPY backend/LoanEligibility.Api.csproj backend/
RUN dotnet restore backend/LoanEligibility.Api.csproj

COPY backend/ backend/
RUN dotnet publish backend/LoanEligibility.Api.csproj --configuration Release --no-restore --output /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime

RUN apt-get update \
  && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*

ENV ASPNETCORE_URLS=http://+:3000
WORKDIR /app
COPY --from=build /app/publish .

USER $APP_UID

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD ["curl", "--fail", "--silent", "http://127.0.0.1:3000/api/health"]

ENTRYPOINT ["dotnet", "LoanEligibility.Api.dll"]
